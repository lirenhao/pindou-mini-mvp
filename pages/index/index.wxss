.page { padding: 28rpx 26rpx 60rpx; }
.hero { padding: 24rpx 4rpx 34rpx; }
.eyebrow { color: #d46b45; font-size: 20rpx; letter-spacing: 3rpx; font-weight: 700; }
.title { font-size: 48rpx; font-weight: 800; margin-top: 12rpx; }
.subtitle { font-size: 26rpx; color: #8b8179; margin-top: 12rpx; }
.panel { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 28rpx rgba(74,49,30,.045); }
.section-title { font-size: 30rpx; font-weight: 750; margin-bottom: 24rpx; }
.primary { background: #d96f4a; color: #fff; font-size: 29rpx; font-weight: 650; border: 0; }
.primary::after { border: 0; }
.ghost { background: #f6f1ec; color: #6f655e; font-size: 29rpx; font-weight: 650; border: 0; }
.ghost::after { border: 0; }
.crop-stage { display: flex; justify-content: center; margin-top: 22rpx; }
.crop-frame { position: relative; overflow: hidden; border-radius: 16rpx; background: #2a241f; }
.crop-image { position: absolute; }
.empty-image { height: 240rpx; background: #fbf7f3; border: 2rpx dashed #e8d9ce; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9d9188; font-size: 25rpx; }
.empty-image-hover { background: #f3ebe4; }
.empty-icon { font-size: 58rpx; color: #d96f4a; line-height: 1.2; margin-bottom: 12rpx; }
.slider-label { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; font-size: 24rpx; color: #8b8179; }
.reset { color: #d96f4a; font-weight: 650; }
.field-row { display: flex; gap: 16rpx; }
.field { flex: 1; min-width: 0; }
.label { display: block; font-size: 23rpx; color: #8b8179; margin-bottom: 12rpx; }
.field input { box-sizing: border-box; width: 100%; height: 76rpx; border: 2rpx solid #eee5de; border-radius: 12rpx; padding: 0 14rpx; font-size: 29rpx; background: #fffdfa; }
.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; }
.switch-label { display: block; font-size: 27rpx; font-weight: 650; }
.switch-note { display: block; margin-top: 4rpx; font-size: 22rpx; color: #9a8f86; }
.hint { font-size: 22rpx; line-height: 1.6; color: #9a8f86; margin-top: 16rpx; }
.hint.warn { color: #c95f3b; }
.generate { margin-top: 24rpx; }
.summary { display: flex; justify-content: space-around; background: #fff7f1; padding: 20rpx 8rpx; border-radius: 16rpx; margin-bottom: 8rpx; text-align: center; }
.summary view { display: flex; flex-direction: column; gap: 8rpx; }
.metric { font-size: 32rpx; font-weight: 800; color: #c95f3b; }
.metric-label { font-size: 21rpx; color: #95877d; }
.preview-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 16rpx; }
.preview-actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.preview-btn { padding: 8rpx 18rpx; background: #fff7f1; color: #c95f3b; border-radius: 999rpx; font-size: 22rpx; font-weight: 650; }
.preview-scale { flex: none; font-size: 22rpx; color: #9a8f86; }
.pattern-viewport { position: relative; width: 100%; margin-top: 16rpx; overflow: hidden; background: #f6f1ec; border-radius: 12rpx; }
.pattern-image { position: absolute; left: 0; top: 0; }
.export { margin-top: 24rpx; }
.color-head { display: flex; align-items: center; color: #9a8f86; font-size: 22rpx; padding: 0 4rpx 12rpx; border-bottom: 1rpx solid #f0e8e2; }
.head-index { width: 120rpx; }
.head-code { flex: 1; }
.head-count { width: 100rpx; text-align: right; }
.color-row { display: flex; align-items: center; padding: 16rpx 4rpx; border-bottom: 1rpx solid #f5efea; }
.index { width: 40rpx; font-size: 26rpx; font-weight: 700; }
.swatch { width: 48rpx; height: 48rpx; border-radius: 10rpx; border: 1rpx solid rgba(0,0,0,.08); margin-right: 20rpx; }
.color-info { flex: 1; display: flex; flex-direction: column; gap: 5rpx; min-width: 0; }
.hex { font-size: 25rpx; font-weight: 700; }
.rgb { font-size: 21rpx; color: #9a8f86; }
.count { width: 110rpx; text-align: right; font-size: 25rpx; font-weight: 650; }
.footer { text-align: center; color: #b1a69d; font-size: 21rpx; padding: 12rpx 0; }
.canvas-clip { position: fixed; left: 0; top: 0; width: 1px; height: 1px; overflow: hidden; opacity: 0; }
.work-canvas { position: absolute; left: 0; top: 0; }
.privacy-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 20; background: rgba(46, 41, 37, 0.45); display: flex; align-items: center; justify-content: center; padding: 48rpx; }
.privacy-card { width: 100%; background: #fff; border-radius: 24rpx; padding: 36rpx 32rpx 28rpx; }
.privacy-title { font-size: 34rpx; font-weight: 750; }
.privacy-body { margin-top: 16rpx; font-size: 26rpx; line-height: 1.6; color: #6f655e; }
.privacy-link { margin-top: 16rpx; font-size: 26rpx; color: #d96f4a; }
.privacy-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.privacy-btn { flex: 1; font-size: 28rpx; margin: 0; }
